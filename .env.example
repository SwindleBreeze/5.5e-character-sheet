# Release settings (docs/PLAN.md, step 9.0). Copy to `.env` (never committed) or set them in the
# build environment. All are optional.

# The app's public name: in the browser title, on the home screen and in About. It must not use
# Wizards of the Coast's trademarks (no "D&D" or "Dungeons & Dragons").
VITE_APP_NAME=5.5e Character Sheet
# A shorter name for the home screen icon.
VITE_APP_SHORT_NAME=Char Sheet

# The path the site is served from: `/` on its own domain, `/<repo>/` on GitHub Pages.
VITE_BASE=/

# Where takedown and other requests go: an email address or a URL. Shown in About.
VITE_CONTACT=

# A "support the project" link (GitHub Sponsors, Ko-fi…), shown in About only when set. Check
# Wizards of the Coast's Fan Content Policy before setting it.
VITE_DONATE_URL=

# `1` keeps the developer screens (/dev/…) in a production build.
VITE_DEV_TOOLS=
